{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rellz-store",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rellz-store-orders",
      "database_id": "GANTI_DENGAN_DATABASE_ID_D1",
      "migrations_dir": "migrations"
    }
  ]
}
