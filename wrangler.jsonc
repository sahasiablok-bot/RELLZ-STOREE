
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rellz-store",
  "main": "src/index.js",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rellz-store-dbb",
      "database_id": "8143a989-7fd9-4027-90eb-c000e0797b1a"
    }
  ]
}
